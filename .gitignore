# macOS Finder metadata
.DS_Store

# SQLite database files (never commit data)
*.db
*.db-shm
*.db-wal

# Raw scraped payloads (large, re-fetchable evidence)
/data/

# Go toolchain caches kept inside the repo, because this sandbox cannot write the
# default GOPATH/GOCACHE locations under $HOME
/.gopath/
/.gocache/
/.gomodcache/
