# macOS Finder metadata
.DS_Store

# SQLite database files (never commit data)
*.db
*.db-shm
*.db-wal

# Cross-compiled Go binaries (build artifacts, built by scripts/build.sh)
/bin/

# Raw scraped payloads (large, re-fetchable evidence)
/data/

# Go toolchain caches kept inside the repo, because this sandbox cannot write the
# default GOPATH/GOCACHE locations under $HOME
/.gopath/
/.gocache/
/.gomodcache/

# Python worker environment for the browser-use tier (M3). It is a build artifact, not
# source: the worker script is committed, the interpreter and its wheels are not.
/.venv-browser/
/.playwright/
/.browseruse/
__pycache__/

# Ad-hoc browser profiles and scratch output from one-off checks (~1,000 vendored extension
# files). Throwaway artifacts, not source.
/career-check/

# npm/npx caches created inside the repo (this sandbox cannot write ~/.npm)
/.npm-cache/
/.npm-logs/

# Scratch output from one-off browser-use checks (regenerable, not source)
/worker/probe_*.log
/worker/model_compare_*.json
/worker/listings_*_test.json
