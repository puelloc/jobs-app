# Build-context exclusions. The image builds only the Go binaries and the
# worker/ scripts; everything else here would bloat the context or leak data.

# Git, OS
.git
.DS_Store

# Databases (never ship data)
*.db
*.db-shm
*.db-wal

# Runtime data and cross-compiled binaries
/data/
/bin/

# Go caches kept in-repo for the sandboxed dev environment
/.gopath/
/.gocache/
/.gomodcache/

# Python worker venv and scratch (built fresh in the image)
/.venv-browser/
/.playwright/
/.browseruse/
__pycache__/

# Node/npm. The UI is built by its own image (web/Dockerfile, context ./web) and the app image needs
# nothing under web/ at all. web/.npm-cache alone is ~270MB of thousands of small files, which made
# the app's `COPY . .` take ~70s on the NAS and shipped junk into a build layer for no reason.
/web/
/.npm-cache/
/.npm-logs/

# One-off scratch
/career-check/
/worker/probe_*.log
/worker/model_compare_*.json
/worker/listings_*_test.json

# Docs and deploy scripts are host-side, not image content
/docs/
/scripts/
